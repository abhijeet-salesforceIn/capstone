    <decisions>
        <name>Case_Count</name>
        <label>Case Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Count_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_CaseCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Output_Assignment</targetReference>
            </connector>
            <label>Case Count &gt;= 3</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Tenant_Active</name>
        <label>Is Tenant Active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Active_tenant_Assign</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lease_Payment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Priority_Logic</name>
        <label>Priority Logic</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Low</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>High_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_IssueDescription</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>no power</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>High</targetReference>
            </connector>
            <label>High Priority</label>
        </rules>
        <rules>
            <name>Low_Priority</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_IssueDescription</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>faucet</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_IssueDescription</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>leak</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Low</targetReference>
            </connector>
            <label>Low Priority</label>
        </rules>
    </decisions>
