            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Ten_Percent_Increase</name>
        <label>Ten Percent Increase</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_RenewalAction</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>TEN PERCENT INCEREASE</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Warm_Renewal</name>
        <label>Warm Renewal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_RenewalAction</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>WARM RENEWAL</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Determine_Renewal_Recommendation</name>
        <label>Determine Renewal Recommendation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Renewal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>More Than 3 Late</defaultConnectorLabel>
        <rules>
            <name>Zero_Late</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_LatePaymentCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Warm_Renewal</targetReference>
            </connector>
            <label>Zero Late</label>
        </rules>
        <rules>
            <name>X1_to_3_Late</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_LatePaymentCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_LatePaymentCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Ten_Percent_Increase</targetReference>
            </connector>
            <label>1 to 3 Late</label>
        </rules>
    </decisions>
    <environments>Default</environments>
