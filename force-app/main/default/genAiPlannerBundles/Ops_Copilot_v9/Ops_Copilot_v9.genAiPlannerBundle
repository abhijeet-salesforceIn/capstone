        <localActions>
            <fullName>Get_Tenant_Rental_Summary_179oB000000Sdhb</fullName>
            <description>Retrieves and aggregates lease payment and maintenance case records for a specified Tenant Account (AccountId). Calculates total late payments (Past_Due__c = TRUE) and total maintenance cases, evaluating the tenant&apos;s payment history to return a renewal policy recommendation (WARM_RENEWAL, TEN_PERCENT_INCREASE, or NO_RENEWAL) to help property managers draft tenant lease renewal communications.</description>
            <developerName>Get_Tenant_Rental_Summary_179oB000000Sdhb</developerName>
